{
  // Static assets only: no Worker script runs, so requests are free on the Workers Free plan.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marble-draw",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [{ "pattern": "marble.js-studio.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
